{
  "note": "PEEK design tokens. Light and dark values for every semantic colour. Sizes are in points.",
  "color": {
    "page":       { "light": "#F7F7F7", "dark": "#000000", "use": "App background behind screens and grouped content" },
    "surface":    { "light": "#FFFFFF", "dark": "#1C1C1E", "use": "Screen and card background" },
    "fill":       { "light": "#F2F2F7", "dark": "#2C2C2E", "use": "Secondary buttons, chips, empty slots, icon buttons" },
    "ink":        { "light": "#1D1D1F", "dark": "#F5F5F7", "use": "Primary text and icons" },
    "inkSecondary": { "light": "#6E6E73", "dark": "#AEAEB2", "use": "Secondary text" },
    "separator":  { "light": "#E5E5EA", "dark": "#38383A", "use": "Hairlines and card borders" },
    "strong":     { "light": "#1D1D1F", "dark": "#F5F5F7", "use": "Selected segment, accepted slot, shutter ring" },
    "onStrong":   { "light": "#FFFFFF", "dark": "#1D1D1F", "use": "Text and icons on strong" },
    "red":        { "light": "#D9291C", "dark": "#D9291C", "use": "Primary action fill, shutter core. White text on top." },
    "onRed":      { "light": "#FFFFFF", "dark": "#FFFFFF" },
    "redText":    { "light": "#C4231A", "dark": "#FF6B5E", "use": "Red used as text on page or surface" },
    "wordmark":   { "light": "#BA011C", "dark": "#FFFFFF", "use": "PEEK wordmark tint" },
    "photoPaper": { "light": "#FBF3E1", "dark": "#FBF3E1", "use": "Instant-photo border on strips and pack thumbnails. Same in both modes." },
    "cameraChrome": { "light": "#000000", "dark": "#000000", "use": "Full-bleed camera bar on standard iPhone" },
    "overPhotoScrim": { "light": "rgba(0,0,0,0.6)", "dark": "rgba(0,0,0,0.6)", "use": "Labels placed over a photo. White text." }
  },
  "packAccent": {
    "note": "One accent per pack. Always shown next to the pack name or an icon, never as the only signal. Text on an accent fill is #1D1D1F in both modes.",
    "streetStyle": "#22D3EE",
    "kidsPoses": "#C8F53A",
    "animations": "#FF69B4"
  },
  "type": {
    "family": "System (SF Pro). Use Dynamic Type text styles, not fixed sizes, where possible.",
    "screenTitle":   { "size": 22, "weight": "bold", "tracking": -0.4 },
    "cue":           { "size": 24, "weight": "bold", "tracking": -0.5, "use": "Pose name on the photographer side" },
    "subjectCue":    { "size": 42, "weight": "bold", "tracking": -1.2, "use": "Pose name on the subject display" },
    "countdown":     { "size": 120, "weight": "bold", "tracking": -4.8 },
    "body":          { "size": 16, "weight": "regular" },
    "button":        { "size": 16, "weight": "semibold" },
    "railButton":    { "size": 13, "weight": "semibold" },
    "caption":       { "size": 14, "weight": "regular", "color": "inkSecondary" },
    "chip":          { "size": 12, "weight": "bold", "tracking": 0.6, "case": "upper" }
  },
  "radius": {
    "screenCard": 20,
    "photo": 20,
    "photoSmall": 12,
    "button": 14,
    "primaryButton": 16,
    "chip": 16,
    "pill": 22,
    "slot": 8,
    "photoPaper": 4
  },
  "size": {
    "minTouchTarget": 44,
    "iconButton": 44,
    "shutter": 78,
    "shutterRing": 4,
    "shutterGap": 4,
    "slot": { "width": 26, "height": 34, "gap": 6 },
    "railButton": { "width": 122, "minHeight": 54 },
    "primaryButtonHeight": 56,
    "buttonHeight": 50,
    "sideRailWidthRegular": 150,
    "sideBarWidthCompact": 60,
    "referenceFrameBorder": 3,
    "referenceFrameBorderSubject": 5
  },
  "spacing": { "xs": 6, "sm": 10, "md": 14, "lg": 18, "xl": 24 },
  "shadow": {
    "card": { "light": "0 24 60 rgba(0,0,0,0.10)", "dark": "none" },
    "photoPaper": "0 10 26 rgba(0,0,0,0.22)"
  }
}
