// Shared build settings. The Info.plist is generated; do not commit a .plist file.

IPHONEOS_DEPLOYMENT_TARGET = 27.0
TARGETED_DEVICE_FAMILY = 1
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1

SWIFT_VERSION = 6.0
SWIFT_DEFAULT_ACTOR_ISOLATION = MainActor
SWIFT_APPROACHABLE_CONCURRENCY = YES
STRING_CATALOG_GENERATE_SYMBOLS = YES

// Device signing: put `DEVELOPMENT_TEAM = <10-character Team ID>` in Config/Local.xcconfig.
// That file is gitignored. It is included at the end of this file.

GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_CFBundleDisplayName = PEEK
INFOPLIST_KEY_UILaunchScreen_Generation = YES
INFOPLIST_KEY_UIApplicationSceneManifest_Generation = YES
INFOPLIST_KEY_UISupportedInterfaceOrientations = UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight
INFOPLIST_KEY_NSCameraUsageDescription = PEEK uses the camera to take your photo booth shots.
INFOPLIST_KEY_NSPhotoLibraryAddUsageDescription = PEEK saves your finished strips and original shots to Photos.

#include? "Local.xcconfig"
